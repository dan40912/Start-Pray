# Copy this file to `.env` and adjust credentials as needed.
DATABASE_URL="mysql://root:root@localhost:3306/prayercoin_dev"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin session signing secret (use a long random string in every environment).
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"

# Customer session signing secret (must be different from the admin secret).
CUSTOMER_SESSION_SECRET="replace-with-a-different-long-random-secret"

# Admin 2FA (TOTP) shared secret. Admins without a personal 2FA (後台 → 權限設定
# → 我的兩步驟驗證) log in with this. Once every admin has enrolled a personal
# 2FA, remove it to make personal 2FA mandatory.
ADMIN_TOTP_SECRET="replace-with-totp-secret"

# Encryption key for the per-admin 2FA secrets stored in the database. If unset
# it is derived from ADMIN_SESSION_SECRET, and rotating that secret would then
# invalidate every enrolled personal 2FA — so set a dedicated value.
ADMIN_TOTP_ENCRYPTION_KEY="replace-with-another-long-random-secret"

# Media storage driver (PRD-009). "local" (default) writes to the filesystem;
# "object" is a not-yet-configured S3-compatible skeleton that throws on use.
# MEDIA_STORAGE_DRIVER="local"

# Production media directories (used by the "local" driver).
# Keep these outside the repo so deploys do not overwrite user uploads.
# VOICES_STORAGE_DIR="/home/startpraynow/prayer-coin-data/voices"
# UPLOADS_STORAGE_DIR="/home/startpraynow/prayer-coin-data/uploads"

# Optional fallback OTP for temporary testing only (do not enable in production).
# ADMIN_LOGIN_OTP="123456"
# HMAC secret used to pseudonymize guest response cookies and daily IP buckets.
GUEST_FINGERPRINT_SECRET=

# Number of reverse proxies that append to X-Forwarded-For in front of the app.
# Used to read the real client IP for rate limits; see docs/security-hardening.md.
#   Nginx only → 1 ; Cloudflare → Nginx → 2 ; unset → legacy (spoofable) behaviour
# TRUSTED_PROXY_HOPS=1

# Password-reset mail via Resend (https://resend.com). Mail is only sent when
# both are set AND NEXT_PUBLIC_APP_URL is set (the link is built from it).
# RESEND_API_KEY=""
# MAIL_FROM="Start Pray <no-reply@your-domain>"
